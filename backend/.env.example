ENVIRONMENT=development
DATABASE_URL=postgresql+psycopg://postgres:postgres@127.0.0.1:5432/lexcatalyst
AUTO_CREATE_TABLES=false
# LLM calls use each user's own OpenRouter key (Settings). Optional tier defaults:
# OPENROUTER_DEFAULT_HIGH=anthropic/claude-opus-5.5
# OPENROUTER_DEFAULT_MID=anthropic/claude-sonnet-5.5

GOOGLE_CLIENT_ID=
JWT_SECRET_KEY=
# Separate HMAC key for one-day team invite codes. At least 32 characters; required outside development.
CLASS_INVITE_SECRET=
# Seals users' saved OpenRouter keys. Separate from FIELD_ENCRYPTION_KEY. Required outside development.
OPENROUTER_KEY_ENCRYPTION_KEY=
# OPENROUTER_KEY_ENCRYPTION_KEYS_OLD=
# Separate from JWT_SECRET_KEY so the JWT secret can be rotated freely.
# Required outside development. Rotating this makes old `enc:` values unreadable.
FIELD_ENCRYPTION_KEY=
# Comma-separated. Required outside development; empty means no admins.
ADMIN_EMAILS=

CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173,https://lexcatalyst.pages.dev

OPENAI_API_KEY=
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_EMBEDDING_DIMENSIONS=1536

CLOUDFLARE_R2_BUCKET_NAME=lexcatalyst
CLOUDFLARE_R2_ENDPOINT_URL=https://aa1656cdf4783d312f507847447334cb.r2.cloudflarestorage.com
CLOUDFLARE_R2_ACCESS_KEY_ID=
CLOUDFLARE_R2_SECRET_ACCESS_KEY=

# Demo only: lets an admin switch into seeded demo users and load demo data. Keep false otherwise.
DEMO_MODE=false
# Demo only (read only when DEMO_MODE=true): OpenRouter key used by users who haven't added their own.
DEMO_OPENROUTER_KEY=
